    "wm_digit_span_forward": {
      "min_span": 2,
      "max_span": 20,
      "sequences_per_span": 2,
      "stimuli_seed": 42,
      "temperature": 0.0
    },
    "wm_digit_span_reverse": {
      "min_span": 2,
      "max_span": 20,
      "sequences_per_span": 2,
      "stimuli_seed": 42,
      "temperature": 0.0
    },
    "wm_semantic_story_recall": {
      "repeats_per_stimulus": 5,
      "temperature": 0.0
